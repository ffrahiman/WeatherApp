<UserControl x:Class="WeatherApp.Views.ForecastView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WeatherApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid TextElement.Foreground="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 7-Day Forecast -->
        <TextBlock Grid.Row="0"
           Text="7-Day Forecast"
           FontSize="15"
           FontWeight="SemiBold"
           Margin="0,0,0,10" />

        <ItemsControl Grid.Row="1"
              ItemsSource="{Binding Forecast}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#F0F4F8"
                    TextElement.Foreground="#18324A"
                    CornerRadius="8"
                    Margin="4"
                    Padding="8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding DayName}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ShortDate}"
                               FontSize="10"
                               Foreground="Gray"
                               HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding WeatherIcon}"
                               FontSize="24"
                               HorizontalAlignment="Center"
                               Margin="0,6" />
                            <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center">
                        <Run Text="{Binding TempMax}" /><Run Text="°C" />
                            </TextBlock>
                            <TextBlock FontSize="11"
                               Foreground="Gray"
                               HorizontalAlignment="Center">
                        <Run Text="{Binding TempMin}" /><Run Text="°C" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
