<UserControl x:Class="WeatherApp.Views.ForecastView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WeatherApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Style="{StaticResource GlassPanelStyle}">

        <Grid TextElement.Foreground="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 7-Day Forecast -->
            <TextBlock Grid.Row="0"
                       Text="7-DAY FORECAST"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SecondaryWeatherTextBrush}"
                       Margin="0,0,0,12" />

            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding Forecast}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="4,0"
                                Background="Transparent">
                            <StackPanel HorizontalAlignment="Center"
                                        Margin="4,0,4,8">
                                <TextBlock Text="{Binding DayName}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding ShortDate}"
                                           FontSize="10"
                                           Foreground="{StaticResource SecondaryWeatherTextBrush}"
                                           HorizontalAlignment="Center" 
                                           Margin="0,2,0,0"/>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,6,0,0">
                                    <TextBlock FontSize="13"
                                               FontWeight="SemiBold">
                                        <Run Text="{Binding TempMax, StringFormat={}{0:0}}" />
                                        <Run Text="°" />
                                    </TextBlock>

                                    <TextBlock FontSize="13"
                                               Foreground="{StaticResource SecondaryWeatherTextBrush}"
                                               Margin="8,0,0,0">
                                        <Run Text="{Binding TempMin, StringFormat={}{0:0}}" />
                                        <Run Text="°" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>