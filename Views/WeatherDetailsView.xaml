<UserControl x:Class="WeatherApp.Views.WeatherDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Left"
                TextElement.Foreground="White">

        <Border Style="{StaticResource GlassPanelStyle}"
                Width="210"
                Padding="14"
                Margin="0,0,12,0">
            <StackPanel>
                <TextBlock Text="WIND"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryWeatherTextBrush}" />
                <TextBlock FontSize="22"
                           FontWeight="SemiBold"
                           Margin="0,6,0,0">
                    <Run Text="{Binding CurrentWeather.WindSpeed, StringFormat={}{0:0}}" />
                    <Run Text=" km/h" />
                </TextBlock>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource GlassPanelStyle}"
                Width="210"
                Padding="14">
            <StackPanel>
                <TextBlock Text="PRECIPITATION"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryWeatherTextBrush}" />
                <TextBlock FontSize="22"
                           FontWeight="SemiBold"
                           Margin="0,6,0,0">
                    <Run Text="{Binding TodayForecast.PrecipitationSum, StringFormat={}{0:0.0}}" />
                    <Run Text=" mm" />
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>