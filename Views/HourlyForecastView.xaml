<UserControl x:Class="WeatherApp.Views.HourlyForecastView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource GlassPanelStyle}" Padding="14">
        <Grid TextElement.Foreground="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="12-HOUR FORECAST"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SecondaryWeatherTextBrush}"
                       Margin="0,0,0,12" />

            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding HourlyForecast}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel HorizontalAlignment="Center"
                                    Margin="4,0">
                            <TextBlock Text="{Binding DisplayTime}"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource SecondaryWeatherTextBrush}" />
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0">
                                <Run Text="{Binding Temperature, StringFormat={}{0:0}}" />
                                <Run Text="°" />
                            </TextBlock>
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="10"
                                       Foreground="{StaticResource SecondaryWeatherTextBrush}"
                                       Margin="0,3,0,0">
                                <Run Text="{Binding Precipitation, StringFormat={}{0:0.0}}" />
                                <Run Text=" mm" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
