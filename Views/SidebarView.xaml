<UserControl x:Class="WeatherApp.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WeatherApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <!-- Left Sidebar: search + favorites -->
    <Border Background="#F2F5F8"
        Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
        

            <!-- Close Button -->
            <Button Grid.Row="0"
                    Content="✕"
                    Command="{Binding CloseSidebarCommand}"
                    Width="34"
                    Height="34"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,18"
                    ToolTip="Close navigation" />

            <StackPanel Grid.Row="1">
                <!-- Search Box -->
                <TextBlock Text="City Search"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Margin="0,0,0,6" />
                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                            Padding="8,6"
                            FontSize="13" />
                <Button Content="Search"
                        Command="{Binding SearchCitiesCommand}" 
                        Margin="0,6,0,0"
                        Padding="0,7"
                        FontSize="13" />

                <!-- Loading Indicator -->
                <TextBlock Text="Loading..."
                           FontSize="12"
                           Foreground="Gray"
                           Margin="0,6,0,0"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

                <!-- Status Message -->
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="OrangeRed"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="2">
                <!-- Search Results -->
                <TextBlock Text="Results"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Margin="0,12,0,4" />

                <ListBox ItemsSource="{Binding SearchResults}"
                         MaxHeight="140"
                         FontSize="12"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectCityCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    HorizontalContentAlignment="Left"
                                    Padding="4,3"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <TextBlock Text="{Binding DisplayName}" />
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>

            <!-- Favorites -->
            <Grid Grid.Row="3"
                  Margin="0,16,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0"
                           Text="Favorites" 
                           FontWeight="SemiBold"
                           FontSize="12"
                           Margin="0,0,0,6" />

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Favorites}"
                         FontSize="12"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="{Binding Name}"
                                        Command="{Binding DataContext.SelectFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        HorizontalContentAlignment="Left"
                                        Padding="4,3"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand" />

                                <Button Grid.Column="1"
                                        Content="✕"
                                        Command="{Binding DataContext.RemoveFavoritesCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        FontSize="10"
                                        Padding="4,2"
                                        ToolTip="Remove favorite" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>

            <Button Grid.Row="4"
                    Content="Settings"
                    Command="{Binding OpenSettingsCommand}"
                    Height="42"
                    HorizontalContentAlignment="Left"
                    Padding="12,0"
                    ToolTip="Open settings" />
        </Grid>
    </Border>

</UserControl>
