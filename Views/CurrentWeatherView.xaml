<UserControl x:Class="WeatherApp.Views.CurrentWeatherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WeatherApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Width="420"
          TextElement.Foreground="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Current City Weather and Favorite Action -->
        <Grid Grid.Row="0">
            <TextBlock Text="{Binding SelectedCity.DisplayName}"
                       FontSize="24"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

            <Button Content="{Binding FavoriteButtonText}"
                    Style="{StaticResource RoundIconButtonStyle}"
                    Command="{Binding ToggleFavoriteCommand}"
                    HorizontalAlignment="Right"
                    ToolTip="{Binding FavoriteButtonToolTip}" />

        </Grid>

        <!-- Current Temperature -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,12,0,0">
            <TextBlock FontSize="84"
                       FontWeight="ExtraLight"
                       VerticalAlignment="Center">
                    <Run Text="{Binding CurrentWeather.Temperature, StringFormat={}{0:0}}" />
                    <Run Text="°" />
            </TextBlock>
        </StackPanel>

        <!-- Description -->
        <TextBlock Grid.Row="2"
                   Text="{Binding CurrentWeather.Description}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"/>

        <!-- Extra Info -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0"
                    TextElement.Foreground="{StaticResource SecondaryWeatherTextBrush}">
            <TextBlock>
                <Run Text="H: " />
                <Run Text="{Binding TodayForecast.TempMax, StringFormat={}{0:0}}" />
                <Run Text="°" />
            </TextBlock>

            <TextBlock Text="  •  " />

            <TextBlock>
                <Run Text="L: " />
                <Run Text="{Binding TodayForecast.TempMin, StringFormat={}{0:0}}" />
                <Run Text="°" />
            </TextBlock>
        </StackPanel>
    </Grid>

</UserControl>