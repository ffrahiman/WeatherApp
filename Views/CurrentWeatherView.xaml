<UserControl x:Class="WeatherApp.Views.CurrentWeatherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WeatherApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <!-- Current Weather -->
    <StackPanel Grid.Row="0" Margin="0,0,0,24">
        <TextBlock Text="{Binding SelectedCity.DisplayName}" 
               FontSize="22"
               FontWeight="Bold" />

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="{Binding CurrentWeather.WeatherIcon}"
                   FontSize="48"
                   Margin="0,0,16,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="36"
                       FontWeight="Light">
                <Run Text="{Binding CurrentWeather.Temperature}" />
                <Run Text="°C" />
                </TextBlock>
                <TextBlock Text="{Binding CurrentWeather.Description}"
                       FontSize="14"
                       Foreground="Gray" />
                <TextBlock FontSize="12"
                       Foreground="Gray">
                <Run Text="Wind: "/>
                <Run Text="{Binding CurrentWeather.WindSpeed}"/>
                <Run Text="km/h"/>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- Add to favorites button -->
        <Button Content=" + Add to Favorites"
            Command="{Binding AddFavoritesCommand}"
            HorizontalAlignment="Left"
            Margin="0,12,0,0"
            Padding="12,6"
            FontSize="12" />
    </StackPanel>

</UserControl>
