<Window x:Class="WeatherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WeatherApp.Views"
        Title="WeatherApp" Height="650" Width="900" MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Border Panel.ZIndex="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#74C4EC" Offset="0" />
                    <GradientStop Color="#4E9FD3" Offset="0.45" />
                    <GradientStop Color="#2F6F9E" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Right Panel: Current Weather + Forecast -->
        <Grid  Panel.ZIndex="1" Margin="80,32,32,32" TextElement.Foreground="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <views:CurrentWeatherView Grid.Row="0"
                          Margin="0,0,0,24" />

            <views:ForecastView Grid.Row="1" />
            
        </Grid>
        <Button Panel.ZIndex="1"
                Content="☰"
                Command="{Binding ToggleSidebarCommand}"
                Width="44"
                Height="44"
                Margin="20"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                FontSize="20"
                ToolTip="Open navigation" />
        <Button Panel.ZIndex="2"
                Command="{Binding CloseSidebarCommand}"
                Visibility="{Binding IsSidebarOpen,
                            Converter={StaticResource BoolToVisibility}}"
                Background="#66000000"
                BorderThickness="0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Button.Template>
        </Button>
        
        <!-- Sidebar -->
        <views:SidebarView Panel.ZIndex="3"
                   Width="300"
                   HorizontalAlignment="Left"
                   Visibility="{Binding IsSidebarOpen,
                       Converter={StaticResource BoolToVisibility}}" />
        
    </Grid>
</Window>
