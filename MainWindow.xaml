<Window x:Class="WeatherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WeatherApp.Views"
        Title="WeatherApp" Height="650" Width="900" MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Border Panel.ZIndex="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#74C4EC" Offset="0" />
                    <GradientStop Color="#4E9FD3" Offset="0.45" />
                    <GradientStop Color="#2F6F9E" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Right Panel: Current Weather + Forecast -->
        <Grid  Panel.ZIndex="1" Margin="80,32,32,32" TextElement.Foreground="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <!-- Current Weather -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="{Binding SelectedCity.DisplayName}" 
                           FontSize="22"
                           FontWeight="Bold" />

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="{Binding CurrentWeather.WeatherIcon}"
                               FontSize="48"
                               Margin="0,0,16,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="36"
                                   FontWeight="Light">
                            <Run Text="{Binding CurrentWeather.Temperature}" />
                            <Run Text="°C" />
                        </TextBlock>
                        <TextBlock Text="{Binding CurrentWeather.Description}"
                                   FontSize="14"
                                   Foreground="Gray" />
                        <TextBlock FontSize="12"
                                   Foreground="Gray">
                            <Run Text="Wind: "/>
                            <Run Text="{Binding CurrentWeather.WindSpeed}"/>
                            <Run Text="km/h"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                
                <!-- Add to favorites button -->
                <Button Content=" + Add to Favorites"
                        Command="{Binding AddFavoritesCommand}"
                        HorizontalAlignment="Left"
                        Margin="0,12,0,0"
                        Padding="12,6"
                        FontSize="12" />
            </StackPanel>
            
            <!-- 7-Day Forecast -->
            <TextBlock Grid.Row="1"
                       Text="7-Day Forecast"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10" />

            <ItemsControl Grid.Row="2"
                          ItemsSource="{Binding Forecast}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#F0F4F8"
                                TextElement.Foreground="#18324A"
                                CornerRadius="8"
                                Margin="4"
                                Padding="8">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding DayName}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding ShortDate}"
                                           FontSize="10"
                                           Foreground="Gray"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding WeatherIcon}"
                                           FontSize="24"
                                           HorizontalAlignment="Center"
                                           Margin="0,6" />
                                <TextBlock FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center">
                                    <Run Text="{Binding TempMax}" /><Run Text="°C" />
                                </TextBlock>
                                <TextBlock FontSize="11"
                                           Foreground="Gray"
                                           HorizontalAlignment="Center">
                                    <Run Text="{Binding TempMin}" /><Run Text="°C" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
        <Button Panel.ZIndex="1"
                Content="☰"
                Command="{Binding ToggleSidebarCommand}"
                Width="44"
                Height="44"
                Margin="20"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                FontSize="20"
                ToolTip="Open navigation" />
        <Button Panel.ZIndex="2"
                Command="{Binding CloseSidebarCommand}"
                Visibility="{Binding IsSidebarOpen,
                            Converter={StaticResource BoolToVisibility}}"
                Background="#66000000"
                BorderThickness="0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Button.Template>
        </Button>
        
        <!-- Sidebar -->
        <views:SidebarView Panel.ZIndex="3"
                   Width="300"
                   HorizontalAlignment="Left"
                   Visibility="{Binding IsSidebarOpen,
                       Converter={StaticResource BoolToVisibility}}" />
        
    </Grid>
</Window>
