<Window x:Class="WeatherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WeatherApp.Views"
        xmlns:models="clr-namespace:WeatherApp.Models"
        Title="WeatherApp" Height="650" Width="900" MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <LinearGradientBrush x:Key="ClearDayBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F3D27A" Offset="0" />
            <GradientStop Color="#67B7E1" Offset="0.35" />
            <GradientStop Color="#2D75A5" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ClearNightBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#101A35" Offset="0" />
            <GradientStop Color="#253A67" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CloudyDayBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8FA9B8" Offset="0" />
            <GradientStop Color="#4F7085" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CloudyNightBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#202C3B" Offset="0" />
            <GradientStop Color="#394B60" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="RainDayBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#6688A0" Offset="0" />
            <GradientStop Color="#304F68" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="RainNightBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#121D2B" Offset="0" />
            <GradientStop Color="#273A4E" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SnowDayBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#A8C9D6" Offset="0" />
            <GradientStop Color="#587A90" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SnowNightBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#27354B" Offset="0" />
            <GradientStop Color="#53657A" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FogDayBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#9AAAB1" Offset="0" />
            <GradientStop Color="#667880" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FogNightBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#252E36" Offset="0" />
            <GradientStop Color="#45515B" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="StormDayBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#46566C" Offset="0" />
            <GradientStop Color="#202A3A" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="StormNightBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#111522" Offset="0" />
            <GradientStop Color="#242C42" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="WeatherBackgroundStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{StaticResource ClearDayBackground}" />

            <Style.Triggers>
                <DataTrigger Binding="{Binding WeatherTheme}"
                             Value="{x:Static models:WeatherTheme.ClearNight}">
                    <Setter Property="Background"
                            Value="{StaticResource ClearNightBackground}" />
                </DataTrigger>

                <DataTrigger Binding="{Binding WeatherTheme}"
                             Value="{x:Static models:WeatherTheme.CloudyDay}">
                    <Setter Property="Background"
                            Value="{StaticResource CloudyDayBackground}" />
                </DataTrigger>

                <DataTrigger Binding="{Binding WeatherTheme}"
                             Value="{x:Static models:WeatherTheme.CloudyNight}">
                    <Setter Property="Background"
                            Value="{StaticResource CloudyNightBackground}" />
                </DataTrigger>

                <DataTrigger Binding="{Binding WeatherTheme}"
                             Value="{x:Static models:WeatherTheme.RainDay}">
                    <Setter Property="Background"
                            Value="{StaticResource RainDayBackground}" />
                </DataTrigger>

                <DataTrigger Binding="{Binding WeatherTheme}"
                             Value="{x:Static models:WeatherTheme.RainNight}">
                    <Setter Property="Background"
                            Value="{StaticResource RainNightBackground}" />
                </DataTrigger>

                <DataTrigger Binding="{Binding WeatherTheme}"
                             Value="{x:Static models:WeatherTheme.SnowDay}">
                    <Setter Property="Background"
                            Value="{StaticResource SnowDayBackground}" />
                </DataTrigger>

                <DataTrigger Binding="{Binding WeatherTheme}"
                             Value="{x:Static models:WeatherTheme.SnowNight}">
                    <Setter Property="Background"
                            Value="{StaticResource SnowNightBackground}" />
                </DataTrigger>

                <DataTrigger Binding="{Binding WeatherTheme}"
                             Value="{x:Static models:WeatherTheme.FogDay}">
                    <Setter Property="Background"
                            Value="{StaticResource FogDayBackground}" />
                </DataTrigger>

                <DataTrigger Binding="{Binding WeatherTheme}"
                             Value="{x:Static models:WeatherTheme.FogNight}">
                    <Setter Property="Background"
                            Value="{StaticResource FogNightBackground}" />
                </DataTrigger>

                <DataTrigger Binding="{Binding WeatherTheme}"
                             Value="{x:Static models:WeatherTheme.StormDay}">
                    <Setter Property="Background"
                            Value="{StaticResource StormDayBackground}" />
                </DataTrigger>

                <DataTrigger Binding="{Binding WeatherTheme}"
                             Value="{x:Static models:WeatherTheme.StormNight}">
                    <Setter Property="Background"
                            Value="{StaticResource StormNightBackground}" />
                </DataTrigger>

            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Panel.ZIndex="0"
                Style="{StaticResource WeatherBackgroundStyle}" />
        <Border Panel.ZIndex="0"
                Background="#18000000" />

        <!-- Right Panel: Current Weather + Recommendation + Forecast -->
        <Grid  Panel.ZIndex="1" Margin="24,24,24,28" TextElement.Foreground="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <views:CurrentWeatherView Grid.Row="0"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="40,36,40,20" />

            <views:RecommendationView Grid.Row="1"
                                      Margin="0,0,0,12" />

            <views:ForecastView Grid.Row="2"
                                MaxHeight="190" />
            
        </Grid>
        <Button Panel.ZIndex="1"
                Content="☰"
                Style="{StaticResource RoundIconButtonStyle}"
                Command="{Binding ToggleSidebarCommand}"
                Margin="20"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                ToolTip="Open navigation" />
        <Button Panel.ZIndex="2"
                Command="{Binding CloseSidebarCommand}"
                Visibility="{Binding IsSidebarOpen,
                            Converter={StaticResource BoolToVisibility}}"
                Background="#66000000"
                BorderThickness="0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Button.Template>
        </Button>
        
        <!-- Sidebar -->
        <views:SidebarView Panel.ZIndex="3"
                   Width="300"
                   HorizontalAlignment="Left"
                   Visibility="{Binding IsSidebarOpen,
                       Converter={StaticResource BoolToVisibility}}" />

        <Button Panel.ZIndex="4"
                Command="{Binding CloseSettingsCommand}"
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}"
                Background="#99000000"
                BorderThickness="0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Button.Template>
        </Button>
        
        <views:SettingsView Panel.ZIndex="5"
                    Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}" />

    </Grid>
</Window>
